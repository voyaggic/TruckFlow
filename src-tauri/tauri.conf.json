{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TruckFlow",
  "version": "0.1.0",
  "identifier": "com.truckflow.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TruckFlow",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5NDEwNEU0M0E0N0Y3RQpSV1IrZjZSRFRoQ1VEM1IwaWs4NDJ1RUdPaE1Qd3VVaFBQd0JiUnJTMzZQempyZVIvQklUSnNodAo=",
      "endpoints": ["http://127.0.0.1:9797/latest.json"],
      "dangerousInsecureTransportProtocol": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
